# Profil: KRig 1.5.12 mot Kryptex-poolen (PPS+). Festet lenke og SHA-256, ingen hemmeligheter.
# {ADDRESS} byttes med --address og {WORKER} med gpu-<UUID8> i entrypoint. Verdiene har ingen mellomrom.
# SHA-256 er identisk med digesten GitHub oppgir for filen (27. okt 2026).
MINER_URL=https://github.com/kryptex/krig-miner/releases/download/v1.5.12/krig-miner-1.5.12-linux-x64.tar.gz
MINER_SHA256=6c456f6540a26ab2dd5fa02434d5827f09d19e06001ef0e6eef5ac1f80b17cea
MINER_BIN=krig-miner
MINER_ARGS=--coin pearl --url stratum+ssl://prl.kryptex.network:8048 --user {ADDRESS}/{WORKER} --no-tui
